# Optional: path to a custom football-trained YOLO model.
# If unset, the service uses the generic YOLO person detector.
YOLO_MODEL=yolo11n.pt

# Upload cap (bytes). Raise this only after configuring disk/object storage limits.
MAX_UPLOAD_BYTES=20000000000

# Sample every Nth frame during tracking. Higher values are faster but may miss brief moments.
TRACK_FRAME_STRIDE=8

# Local development only. Use private object storage + auth for production.
DATA_DIR=./data

# Comma-separated frontend origins. Add your real deployed frontend origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional football event model adapter. The command must accept --video PATH --output PATH
# and write JSON: [{"timestamp":123.4,"label":"goal","confidence":0.93}]
# Do not set this to an unvalidated generic detector and call its output verified.
PITCHPERFECT_EVENT_MODEL_COMMAND=
PITCHPERFECT_EVENT_MODEL_NAME=

# Optional pretrained SoccerNet goal spotting adapter.
# Install requirements-event-model.txt first. The adapter downloads config.yaml from Hugging Face.
# This checkpoint detects goal/match-action events only; it does NOT classify
# celebrations, emotional reactions, or manager responses.
PITCHPERFECT_EVENT_MODEL_COMMAND=python -m app.soccernet_event_model
PITCHPERFECT_EVENT_MODEL_NAME=OpenSportsLab/OSL-loc-snbas-2025-e2e
PITCHPERFECT_SOCCERNET_WEIGHTS=OpenSportsLab/OSL-loc-snbas-2025-e2e
PITCHPERFECT_GOAL_THRESHOLD=0.35
